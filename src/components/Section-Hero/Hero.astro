---
import styles from "./Hero.module.css";
import CTAButton from '../../components/Buttons/CTAButton.astro';
---


<header class={styles.hero}>

  <video id="heroVideo" class={styles.desktopOnly} autoplay loop muted playsinline>
    <source src="public/video/MDC-Hero.webm" type="video/webm" />
    <source src="public/video/MDC-Hero.mp4" type="video/mp4" />
  </video>
  <img src="/video/MDC-Hero-backup.webp" alt="Background image" class={styles.mobileOnly} />

   <div class={styles.container}><h1>Brain Tonics and Psychedelic Elixers of all Kinds!</h1>
  <CTAButton>Start you Journey Today!</CTAButton>
  </div>

</header>

<script is:inline>
  const video = document.getElementById('heroVideo');
  if (video) {
    video.playbackRate = 0.9; // slow down here
  }
</script>